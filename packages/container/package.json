{
  "name": "@oyinlola141/lattice-container",
  "version": "0.1.4",
  "description": "Token-based dependency injection container for managing application dependencies and service lifetimes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "tsc -p tsconfig.json --clean"
  },
  "dependencies": {
    "@oyinlola141/lattice-errors": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "module": "./dist/index.js",
  "keywords": [
    "lattice",
    "di",
    "dependency-injection",
    "container"
  ],
  "homepage": "https://github.com/oyinlola-tech/lattice#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/lattice"
  }
}
