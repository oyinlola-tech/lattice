{
  "name": "@zudoliblib/testing",
  "version": "0.1.3",
  "description": "Test helpers, fixtures, mocks, and utilities for testing Zudolib applications.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "../../node_modules/.bin/vitest run"
  },
  "dependencies": {
    "@zudoliblib/config": "workspace:*",
    "@zudoliblib/constants": "workspace:*",
    "@zudoliblib/container": "workspace:*",
    "@zudoliblib/errors": "workspace:*",
    "@zudoliblib/events": "workspace:*",
    "@zudoliblib/http": "workspace:*",
    "@zudoliblib/logger": "workspace:*",
    "@zudoliblib/messaging": "workspace:*",
    "@zudoliblib/middleware": "workspace:*",
    "@zudoliblib/queue": "workspace:*",
    "@zudoliblib/security": "workspace:*",
    "@zudoliblib/serialization": "workspace:*",
    "@zudoliblib/storage": "workspace:*",
    "@zudoliblib/types": "workspace:*",
    "@zudoliblib/validation": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zudolib",
    "testing",
    "mocks",
    "fixtures",
    "vitest"
  ],
  "homepage": "https://github.com/oyinlola-tech/zudolib#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudolib"
  }
}
