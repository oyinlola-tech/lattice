{
  "name": "@zudo/testing",
  "version": "0.1.3",
  "description": "Test helpers, fixtures, mocks, and utilities for testing Zudo applications.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "../../node_modules/.bin/vitest run"
  },
  "dependencies": {
    "@zudo/config": "workspace:*",
    "@zudo/constants": "workspace:*",
    "@zudo/container": "workspace:*",
    "@zudo/errors": "workspace:*",
    "@zudo/events": "workspace:*",
    "@zudo/http": "workspace:*",
    "@zudo/logger": "workspace:*",
    "@zudo/messaging": "workspace:*",
    "@zudo/middleware": "workspace:*",
    "@zudo/queue": "workspace:*",
    "@zudo/security": "workspace:*",
    "@zudo/serialization": "workspace:*",
    "@zudo/storage": "workspace:*",
    "@zudo/types": "workspace:*",
    "@zudo/validation": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zudo",
    "testing",
    "mocks",
    "fixtures",
    "vitest"
  ],
  "homepage": "https://github.com/oyinlola-tech/zudo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudo"
  }
}
