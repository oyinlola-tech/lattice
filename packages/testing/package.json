{
  "name": "@lattice/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Testing infrastructure for the Lattice framework — test containers, fakes, fixtures, mocks, assertions, and test utilities.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "../../node_modules/.bin/vitest run"
  },
  "dependencies": {
    "@lattice/config": "workspace:*",
    "@lattice/constants": "workspace:*",
    "@lattice/container": "workspace:*",
    "@lattice/errors": "workspace:*",
    "@lattice/events": "workspace:*",
    "@lattice/http": "workspace:*",
    "@lattice/logger": "workspace:*",
    "@lattice/messaging": "workspace:*",
    "@lattice/middleware": "workspace:*",
    "@lattice/queue": "workspace:*",
    "@lattice/security": "workspace:*",
    "@lattice/serialization": "workspace:*",
    "@lattice/storage": "workspace:*",
    "@lattice/types": "workspace:*",
    "@lattice/validation": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT"
}
