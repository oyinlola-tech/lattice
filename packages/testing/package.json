{
  "name": "@oyinlola141/lattice-testing",
  "version": "0.1.1",
  "description": "Testing infrastructure for the Lattice framework — test containers, fakes, fixtures, mocks, assertions, and test utilities.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "../../node_modules/.bin/vitest run"
  },
  "dependencies": {
    "@oyinlola141/lattice-config": "workspace:*",
    "@oyinlola141/lattice-constants": "workspace:*",
    "@oyinlola141/lattice-container": "workspace:*",
    "@oyinlola141/lattice-errors": "workspace:*",
    "@oyinlola141/lattice-events": "workspace:*",
    "@oyinlola141/lattice-http": "workspace:*",
    "@oyinlola141/lattice-logger": "workspace:*",
    "@oyinlola141/lattice-messaging": "workspace:*",
    "@oyinlola141/lattice-middleware": "workspace:*",
    "@oyinlola141/lattice-queue": "workspace:*",
    "@oyinlola141/lattice-security": "workspace:*",
    "@oyinlola141/lattice-serialization": "workspace:*",
    "@oyinlola141/lattice-storage": "workspace:*",
    "@oyinlola141/lattice-types": "workspace:*",
    "@oyinlola141/lattice-validation": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
