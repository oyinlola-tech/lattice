{
  "name": "@zudolib/testing",
  "version": "1.0.0",
  "description": "Test helpers, fixtures, mocks, and utilities for testing Zudolib applications.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "../../node_modules/.bin/vitest run"
  },
  "dependencies": {
    "@zudolib/config": "workspace:*",
    "@zudolib/constants": "workspace:*",
    "@zudolib/container": "workspace:*",
    "@zudolib/errors": "workspace:*",
    "@zudolib/events": "workspace:*",
    "@zudolib/http": "workspace:*",
    "@zudolib/logger": "workspace:*",
    "@zudolib/messaging": "workspace:*",
    "@zudolib/middleware": "workspace:*",
    "@zudolib/queue": "workspace:*",
    "@zudolib/security": "workspace:*",
    "@zudolib/serialization": "workspace:*",
    "@zudolib/storage": "workspace:*",
    "@zudolib/types": "workspace:*",
    "@zudolib/validation": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zudolib",
    "testing",
    "mocks",
    "fixtures",
    "vitest"
  ],
  "homepage": "https://github.com/oyinlola-tech/zudo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudo"
  }
}
