{
  "name": "@oyinlola141/lattice-cli",
  "version": "0.2.0",
  "description": "Command-line interface for scaffolding, generating, and managing Lattice framework projects.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "lattice": "./dist/src/bin/lattice.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/src/scripts && cp src/scripts/postinstall.js dist/src/scripts/postinstall.js",
    "dev": "tsx src/bin/lattice.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@oyinlola141/lattice-config": "workspace:*",
    "@oyinlola141/lattice-core": "workspace:*",
    "@oyinlola141/lattice-errors": "workspace:*",
    "@oyinlola141/lattice-logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "lattice",
    "cli",
    "scaffold",
    "generate",
    "dev"
  ],
  "homepage": "https://github.com/oyinlola-tech/lattice#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/lattice"
  }
}
