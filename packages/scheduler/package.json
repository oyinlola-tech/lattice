{
  "name": "@zudolib/scheduler",
  "version": "0.1.3",
  "description": "Scheduled task and job infrastructure with cron-like scheduling, persistence, and worker management.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@zudolib/errors": "workspace:*",
    "@zudolib/constants": "workspace:*",
    "@zudolib/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zudolib",
    "scheduler",
    "cron",
    "jobs"
  ],
  "homepage": "https://github.com/oyinlola-tech/zudolib#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudolib"
  }
}
