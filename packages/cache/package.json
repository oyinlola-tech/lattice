{
  "name": "@zudolib/cache",
  "version": "0.1.3",
  "description": "Caching primitives, abstractions, and adapters for the Zudo framework.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@zudolib/errors": "workspace:*",
    "@zudolib/types": "workspace:*",
    "@zudolib/serialization": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zudo",
    "cache",
    "redis",
    "memory",
    "tags"
  ],
  "homepage": "https://github.com/oyinlola-tech/zudo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudo"
  }
}
