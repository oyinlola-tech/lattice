{
  "name": "@zudoliblib/rpc",
  "version": "0.1.3",
  "description": "Remote procedure call infrastructure for Zudolib applications.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@zudoliblib/errors": "workspace:*",
    "@zudoliblib/constants": "workspace:*",
    "@zudoliblib/types": "workspace:*",
    "@zudoliblib/schema": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zudolib",
    "rpc",
    "remote",
    "procedure"
  ],
  "homepage": "https://github.com/oyinlola-tech/zudolib#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudolib"
  }
}
