{
  "name": "@oyinlola141/lattice-runtime",
  "version": "0.1.4",
  "description": "Application runtime orchestrator for Lattice framework lifecycle management.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "tsc -p tsconfig.json --clean"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@oyinlola141/lattice-errors": "workspace:*",
    "@oyinlola141/lattice-constants": "workspace:*",
    "@oyinlola141/lattice-container": "workspace:*",
    "@oyinlola141/lattice-config": "workspace:*",
    "@oyinlola141/lattice-logger": "workspace:*",
    "@oyinlola141/lattice-events": "workspace:*",
    "@oyinlola141/lattice-core": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "module": "./dist/index.js"
}
