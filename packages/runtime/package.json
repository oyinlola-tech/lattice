{
  "name": "@lattice/runtime",
  "version": "0.1.0",
  "description": "Application runtime orchestrator for Lattice framework lifecycle management.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "tsc -p tsconfig.json --clean"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@lattice/errors": "0.1.0",
    "@lattice/constants": "0.1.0",
    "@lattice/container": "0.1.0",
    "@lattice/config": "0.1.0",
    "@lattice/logger": "0.1.0",
    "@lattice/events": "0.1.0",
    "@lattice/core": "0.1.0"
  },
  "license": "MIT"
}
