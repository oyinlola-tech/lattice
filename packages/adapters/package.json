{
  "name": "@lattice/adapters",
  "version": "0.1.0",
  "private": true,
  "description": "Boundary layer between Lattice and external platforms — adapter contracts, registry, capabilities, and transport abstractions.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@lattice/errors": "workspace:*",
    "@lattice/constants": "workspace:*",
    "@lattice/types": "workspace:*",
    "@lattice/lifecycle": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
