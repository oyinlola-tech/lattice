{
  "name": "@lattice/events",
  "version": "0.1.0",
  "private": true,
  "description": "Event system and event bus infrastructure for the Lattice framework.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lattice/errors": "0.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}