{
  "name": "@oyinlola141/lattice-http",
  "version": "0.1.3",
  "description": "HTTP primitives, request handling, routing, middleware, and server infrastructure for Lattice applications.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@oyinlola141/lattice-core": "workspace:*",
    "@oyinlola141/lattice-errors": "workspace:*",
    "@oyinlola141/lattice-logger": "workspace:*",
    "@oyinlola141/lattice-security": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "fluent-ffmpeg": "^2.1.3",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "lattice",
    "http",
    "server",
    "middleware",
    "routing"
  ],
  "homepage": "https://github.com/oyinlola-tech/lattice#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/lattice"
  }
}
