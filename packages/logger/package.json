{
  "name": "@oyinlola141/lattice-logger",
  "version": "0.1.3",
  "description": "Structured logging with transports, log levels, and context propagation for Lattice applications.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@oyinlola141/lattice-errors": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "lattice",
    "logging",
    "structured-logs",
    "transports"
  ],
  "homepage": "https://github.com/oyinlola-tech/lattice#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/lattice"
  }
}
