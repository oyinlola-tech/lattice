{
  "name": "@oyinlola141/lattice-serialization",
  "version": "0.1.4",
  "description": "Data translation layer with JSON serializer, type transformers, envelopes, and registry for Lattice applications.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@oyinlola141/lattice-constants": "workspace:*",
    "@oyinlola141/lattice-errors": "workspace:*",
    "@oyinlola141/lattice-types": "workspace:*",
    "@oyinlola141/lattice-validation": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "keywords": [
    "lattice",
    "serialization",
    "json",
    "transformers"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "module": "./dist/index.js",
  "homepage": "https://github.com/oyinlola-tech/lattice#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/lattice"
  }
}
