{
  "name": "@oyinlola141/lattice-permissions",
  "version": "0.1.3",
  "description": "Authorization engine for the Lattice framework — RBAC, ABAC, resource policies, wildcards, role hierarchy, and ability compilation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@oyinlola141/lattice-errors": "workspace:*",
    "@oyinlola141/lattice-constants": "workspace:*"
  },
  "peerDependencies": {
    "@oyinlola141/lattice-http": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@oyinlola141/lattice-http": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
