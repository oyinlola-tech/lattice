{
  "name": "lattice",
  "version": "0.1.0",
  "private": true,
  "description": "Lattice framework monorepo.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "examples/micro-service/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "build:core": "pnpm --filter @lattice/core run build",
    "typecheck:core": "pnpm --filter @lattice/core run typecheck",
    "architect:check": "node scripts/architect-check.js",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\"",
    "lint": "echo 'Lint: no linter configured yet'",
    "test": "pnpm vitest run tests/architect"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "prettier": "^3.9.6",
    "vitest": "^4.1.11"
  }
}