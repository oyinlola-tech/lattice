{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@zudo/http": ["../../packages/http/src/index.ts"],
      "@zudo/logger": ["../../packages/logger/src/index.ts"],
      "@zudo/errors": ["../../packages/errors/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
