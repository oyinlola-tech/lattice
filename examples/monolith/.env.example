# Application
APP_NAME=Zudo Monolith
APP_VERSION=0.1.0
APP_ENV=development
APP_PORT=3000
APP_HOST=localhost
APP_SECRET=change-me-in-production

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/zudo_monolith
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text

# Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Workers
WORKER_CONCURRENCY=5
